# OpenSSL is bundled like the other libraries unless another TLS backend was chosen, it is listed
# in GRPC_SYSTEM_DEPENDENCIES, or a particular OpenSSL was pointed at (GRPC_TLS_PREFIX,
# OPENSSL_ROOT_DIR). The bundled target is libcrypto; libssl is added here next to it.
set(GRPC_OPENSSL_BUNDLED FALSE)
grpc_dependency_is_bundled(_grpc_openssl_bundled openssl)
if(_tls_backend MATCHES "^(auto|openssl)$" AND _grpc_openssl_bundled AND NOT GRPC_TLS_PREFIX AND
   NOT OPENSSL_ROOT_DIR AND NOT DEFINED ENV{OPENSSL_ROOT_DIR})
  grpc_bundled_dependency(_grpc_crypto_target openssl)
  if(_grpc_crypto_target)
    if(NOT TARGET grpc_bundled_openssl_ssl)
      add_library(grpc_bundled_openssl_ssl UNKNOWN IMPORTED)
      foreach(_grpc_prop IN ITEMS IMPORTED_LOCATION IMPORTED_LOCATION_DEBUG)
        get_target_property(_grpc_crypto_lib ${_grpc_crypto_target} ${_grpc_prop})
        if(_grpc_crypto_lib)
          get_filename_component(_grpc_lib_dir "${_grpc_crypto_lib}" DIRECTORY)
          get_filename_component(_grpc_lib_name "${_grpc_crypto_lib}" NAME)
          string(REPLACE "crypto" "ssl" _grpc_lib_name "${_grpc_lib_name}")
          set_target_properties(grpc_bundled_openssl_ssl PROPERTIES
            ${_grpc_prop} "${_grpc_lib_dir}/${_grpc_lib_name}")
        endif()
      endforeach()
      get_target_property(_grpc_crypto_inc ${_grpc_crypto_target} INTERFACE_INCLUDE_DIRECTORIES)
      set_target_properties(grpc_bundled_openssl_ssl PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_grpc_crypto_inc}"
        INTERFACE_LINK_LIBRARIES ${_grpc_crypto_target})
    endif()
    grpc_check_library(_grpc_usable grpc_bundled_openssl_ssl openssl/ssl.h SSL_CTX_new)
    if(_grpc_usable)
      set(GRPC_OPENSSL_BUNDLED TRUE)
      set(_tls_backend openssl)
    else()
      set(GRPC_BUNDLED_openssl_ERROR "the bundled build ${_grpc_usable_REASON}")
    endif()
  endif()
  if(NOT GRPC_OPENSSL_BUNDLED)
    message(WARNING "ezGRPC-next: the bundled OpenSSL is unavailable, so the system one is used if present.\n${GRPC_BUNDLED_openssl_ERROR}")
  endif()
endif()

if(_tls_backend STREQUAL "auto")
  find_package(OpenSSL QUIET)
  if(OpenSSL_FOUND)
    set(_tls_backend openssl)
  else()
    set(_tls_backend none)
  endif()
endif()
set(GRPC_TLS_LIBRARIES)
set(GRPC_TLS_SOURCE)
set(GRPC_TLS_ENABLED FALSE)
if(NOT _tls_backend STREQUAL "none")
  if(GRPC_OPENSSL_BUNDLED)
    set(GRPC_TLS_SOURCE src/grpc_tls_openssl.c)
    set(GRPC_TLS_LIBRARIES grpc_bundled_openssl_ssl ${_grpc_crypto_target})
  elseif(_tls_backend STREQUAL "openssl" OR _tls_backend STREQUAL "libressl" OR
     _tls_backend STREQUAL "boringssl" OR _tls_backend STREQUAL "awslc")
    if(NOT TARGET OpenSSL::SSL OR NOT TARGET OpenSSL::Crypto)
      find_package(OpenSSL REQUIRED)
    endif()
    set(GRPC_TLS_SOURCE src/grpc_tls_openssl.c)
    set(GRPC_TLS_LIBRARIES OpenSSL::SSL OpenSSL::Crypto)
  elseif(_tls_backend STREQUAL "wolfssl")
    grpc_pkg_check_modules(WOLFSSL REQUIRED IMPORTED_TARGET wolfssl)
    set(GRPC_TLS_SOURCE src/grpc_tls_wolfssl.c)
    set(GRPC_TLS_LIBRARIES PkgConfig::WOLFSSL)
  elseif(_tls_backend STREQUAL "gnutls")
    grpc_pkg_check_modules(GNUTLS REQUIRED IMPORTED_TARGET gnutls)
    set(GRPC_TLS_SOURCE src/grpc_tls_gnutls.c)
    set(GRPC_TLS_LIBRARIES PkgConfig::GNUTLS)
  elseif(_tls_backend STREQUAL "rustls")
    if(WIN32)
      message(FATAL_ERROR "The rustls backend is currently supported only on Unix; use OpenSSL on Windows")
    endif()
    find_path(RUSTLS_INCLUDE_DIR rustls.h REQUIRED)
    find_library(RUSTLS_LIBRARY NAMES rustls REQUIRED)
    set(GRPC_TLS_SOURCE src/grpc_tls_rustls.c)
    set(GRPC_TLS_LIBRARIES "${RUSTLS_LIBRARY}" gcc_s util rt m dl)
  endif()
  set(GRPC_TLS_ENABLED TRUE)
  if(GRPC_OPENSSL_BUNDLED)
    set(_grpc_tls_report "openssl, bundled ${GRPC_BUNDLED_openssl_VERSION}")
    if(_grpc_openssldir)
      string(APPEND _grpc_tls_report " (OPENSSLDIR ${_grpc_openssldir})")
    endif()
    grpc_report_dependency(tls "${_grpc_tls_report}")
  elseif(_tls_backend MATCHES "^(openssl|libressl|boringssl|awslc)$")
    grpc_report_dependency(tls "system ${_tls_backend} ${OPENSSL_VERSION} (${OPENSSL_SSL_LIBRARY})")
  else()
    grpc_report_dependency(tls "system ${_tls_backend}")
  endif()
else()
  grpc_report_dependency(tls "disabled (GRPC_TLS_BACKEND=none)")
endif()

# HTTP/3: ngtcp2 (QUIC), nghttp3 (HTTP/3) and the ngtcp2 crypto helper matching the TLS backend.
# LibreSSL and rustls have no helper, so HTTP/3 is unavailable with them (and without TLS).
set(GRPC_HTTP3_FOUND FALSE)
set(GRPC_HTTP3_TARGETS)
set(GRPC_QUIC_TLS_SOURCE)
if(NOT GRPC_HTTP3 STREQUAL "OFF")
  set(_quic_crypto "")
  if(GRPC_OPENSSL_BUNDLED)
    # a system ngtcp2 crypto helper is linked against the system OpenSSL, not this one
    if(GRPC_HTTP3 STREQUAL "ON")
      message(STATUS "HTTP/3 is unavailable with the bundled OpenSSL: build OpenSSL 3.5, ngtcp2 and nghttp3 into one prefix (scripts/build-tls-backend.sh, scripts/build-quic-deps.sh) and pass -DGRPC_TLS_PREFIX=<prefix>, or use -DGRPC_SYSTEM_DEPENDENCIES=openssl")
    endif()
  elseif(_tls_backend STREQUAL "openssl")
    # ngtcp2's ossl helper drives OpenSSL's own QUIC TLS API, added in 3.5
    if(OPENSSL_VERSION VERSION_GREATER_EQUAL "3.5")
      set(_quic_crypto ossl)
    else()
      message(STATUS "HTTP/3 needs OpenSSL >= 3.5 (found ${OPENSSL_VERSION}); see scripts/build-tls-backend.sh")
    endif()
  elseif(_tls_backend STREQUAL "boringssl" OR _tls_backend STREQUAL "awslc")
    set(_quic_crypto boringssl)
  elseif(_tls_backend STREQUAL "gnutls")
    set(_quic_crypto gnutls)
  elseif(_tls_backend STREQUAL "wolfssl")
    set(_quic_crypto wolfssl)
  endif()
  if(_quic_crypto)
    grpc_pkg_check_modules(NGTCP2 QUIET IMPORTED_TARGET libngtcp2>=1.0)
    grpc_pkg_check_modules(NGTCP2_CRYPTO QUIET IMPORTED_TARGET libngtcp2_crypto_${_quic_crypto})
    grpc_pkg_check_modules(NGHTTP3 QUIET IMPORTED_TARGET libnghttp3>=1.0)
    if(NGTCP2_FOUND AND NGTCP2_CRYPTO_FOUND AND NGHTTP3_FOUND)
      set(GRPC_HTTP3_FOUND TRUE)
      set(GRPC_HTTP3_TARGETS PkgConfig::NGTCP2_CRYPTO PkgConfig::NGTCP2 PkgConfig::NGHTTP3)
    else()
      # No pkg-config (Windows / vcpkg): the CMake packages ngtcp2 and nghttp3 install, shared
      # or static. Their config files carry no version check, so it is done on the headers.
      find_package(ngtcp2 CONFIG QUIET)
      find_package(nghttp3 CONFIG QUIET)
      set(_quic_targets)
      foreach(_t IN ITEMS ngtcp2_crypto_${_quic_crypto} ngtcp2 nghttp3)
        string(REGEX REPLACE "_.*" "" _ns "${_t}")
        if(TARGET ${_ns}::${_t})
          list(APPEND _quic_targets ${_ns}::${_t})
        elseif(TARGET ${_ns}::${_t}_static)
          list(APPEND _quic_targets ${_ns}::${_t}_static)
        endif()
      endforeach()
      list(LENGTH _quic_targets _quic_count)
      if(_quic_count EQUAL 3)
        set(_quic_versions_ok TRUE)
        foreach(_lib IN ITEMS ngtcp2 nghttp3)
          get_target_property(_inc ${_lib}::${_lib} INTERFACE_INCLUDE_DIRECTORIES)
          if(NOT _inc)
            get_target_property(_inc ${_lib}::${_lib}_static INTERFACE_INCLUDE_DIRECTORIES)
          endif()
          find_file(_ver_h NAMES version.h PATHS ${_inc} PATH_SUFFIXES ${_lib} NO_DEFAULT_PATH
            NO_CACHE)
          set(_ver "")
          if(_ver_h)
            string(TOUPPER "${_lib}" _up)
            file(STRINGS "${_ver_h}" _ver REGEX "#define ${_up}_VERSION \"")
            string(REGEX REPLACE ".*\"([0-9.]+).*\".*" "\\1" _ver "${_ver}")
          endif()
          unset(_ver_h)
          if(NOT _ver OR _ver VERSION_LESS "1.0")
            message(STATUS "HTTP/3 needs ${_lib} >= 1.0 (found '${_ver}')")
            set(_quic_versions_ok FALSE)
          endif()
        endforeach()
        if(_quic_versions_ok)
          set(GRPC_HTTP3_FOUND TRUE)
          set(GRPC_HTTP3_TARGETS ${_quic_targets})
        endif()
      endif()
    endif()
    if(GRPC_HTTP3_FOUND)
      if(_quic_crypto STREQUAL "ossl" OR _quic_crypto STREQUAL "boringssl")
        set(GRPC_QUIC_TLS_SOURCE src/grpc_quic_tls_openssl.c)
      else()
        set(GRPC_QUIC_TLS_SOURCE src/grpc_quic_tls_${_quic_crypto}.c)
      endif()
    endif()
  endif()
endif()
grpc_feature_enabled(HTTP3 "${GRPC_HTTP3_FOUND}"
  "HTTP/3 (ngtcp2 >= 1.0, nghttp3 >= 1.0 and the ngtcp2 crypto helper for the TLS backend)")
if(GRPC_HTTP3_ENABLED)
  set(GRPC_QUIC_CRYPTO "${_quic_crypto}")
  grpc_report_dependency(ngtcp2/nghttp3 "system (ngtcp2_crypto_${_quic_crypto})")
endif()

set(GRPC_ALLOCATOR_LIBRARIES)
set(GRPC_ALLOCATOR_DEFINE "")
if(GRPC_ALLOCATOR STREQUAL "mimalloc")
  find_library(MIMALLOC_LIBRARY NAMES mimalloc REQUIRED)
  set(GRPC_ALLOCATOR_DEFINE GRPC_USE_MIMALLOC)
  set(GRPC_ALLOCATOR_LIBRARIES "${MIMALLOC_LIBRARY}")
elseif(GRPC_ALLOCATOR STREQUAL "jemalloc")
  if(MSVC)
    message(FATAL_ERROR "The jemalloc allocator is currently supported only on Unix; use default or mimalloc with MSVC")
  endif()
  find_library(JEMALLOC_LIBRARY NAMES jemalloc REQUIRED)
  set(GRPC_ALLOCATOR_DEFINE GRPC_USE_JEMALLOC)
  set(GRPC_ALLOCATOR_LIBRARIES "${JEMALLOC_LIBRARY}")
elseif(NOT GRPC_ALLOCATOR STREQUAL "default")
  message(FATAL_ERROR "GRPC_ALLOCATOR must be default, mimalloc, or jemalloc")
endif()

