# Resolves link items to what an installed consumer can use without our imported targets (which
# are not exported): imported targets become their library files, recursively through
# INTERFACE_LINK_LIBRARIES; Threads::Threads, plain library names and paths are kept; ulog::ulog is
# dropped (it is exported with the library). Used for the static library's install interface and
# the pkg-config Libs.private.
function(grpc_resolve_link_files out)
  set(result)
  foreach(item IN LISTS ARGN)
    string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" item "${item}")
    if(item MATCHES "^\\$<" OR item STREQUAL "ulog::ulog" OR item STREQUAL "")
      continue()
    endif()
    if(item STREQUAL "Threads::Threads" OR NOT TARGET "${item}")
      list(APPEND result "${item}")
      continue()
    endif()
    get_target_property(aliased "${item}" ALIASED_TARGET)
    if(aliased)
      set(item "${aliased}")
    endif()
    get_target_property(type "${item}" TYPE)
    if(NOT type STREQUAL "INTERFACE_LIBRARY")
      get_target_property(loc "${item}" IMPORTED_LOCATION)
      if(NOT loc)
        get_target_property(configs "${item}" IMPORTED_CONFIGURATIONS)
        foreach(cfg IN LISTS configs)
          get_target_property(loc "${item}" IMPORTED_LOCATION_${cfg})
          if(loc)
            break()
          endif()
        endforeach()
      endif()
      if(loc)
        list(APPEND result "${loc}")
      endif()
    endif()
    get_target_property(deps "${item}" INTERFACE_LINK_LIBRARIES)
    if(deps)
      grpc_resolve_link_files(sub ${deps})
      list(APPEND result ${sub})
    endif()
  endforeach()
  set(${out} "${result}" PARENT_SCOPE)
endfunction()

function(grpc_feature_enabled feature found description)
  string(TOUPPER "${GRPC_${feature}}" setting)
  if(setting STREQUAL "ON" AND NOT found)
    message(FATAL_ERROR "${description} was requested but its dependency was not found")
  endif()
  if(setting STREQUAL "OFF")
    set(enabled FALSE)
  elseif(found)
    set(enabled TRUE)
  else()
    set(enabled FALSE)
  endif()
  set(GRPC_${feature}_ENABLED "${enabled}" PARENT_SCOPE)
endfunction()

# Finds a library and returns an imported target for it, trying in order:
#   1. a CMake package (find_package; CONFIG mode unless MODULE_MODE), using the first of
#      CONFIG_TARGETS it defines (vcpkg and upstream CMake packages);
#   2. the pkg-config module PKG_MODULE;
#   3. HEADER plus a library from NAMES, wrapped in an UNKNOWN IMPORTED target.
# Sets <out> to the target name (empty when not found). CMAKE_PREFIX_PATH (GRPC_TLS_PREFIX,
# ~/.local, ...) applies to every step.
function(grpc_find_library_target out)
  cmake_parse_arguments(arg "MODULE_MODE" "PACKAGE;PKG_MODULE;HEADER" "CONFIG_TARGETS;NAMES" ${ARGN})
  set(${out} "" PARENT_SCOPE)
  if(arg_PACKAGE)
    if(arg_MODULE_MODE)
      find_package(${arg_PACKAGE} QUIET)
    else()
      find_package(${arg_PACKAGE} CONFIG QUIET)
    endif()
    foreach(target IN LISTS arg_CONFIG_TARGETS)
      if(TARGET ${target})
        set(${out} ${target} PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endif()
  if(arg_PKG_MODULE)
    string(MAKE_C_IDENTIFIER "GRPC_PC_${arg_PKG_MODULE}" pc_prefix)
    grpc_pkg_check_modules(${pc_prefix} QUIET IMPORTED_TARGET ${arg_PKG_MODULE})
    if(${pc_prefix}_FOUND)
      set(${out} PkgConfig::${pc_prefix} PARENT_SCOPE)
      return()
    endif()
  endif()
  if(arg_HEADER AND arg_NAMES)
    list(GET arg_NAMES 0 first_name)
    string(MAKE_C_IDENTIFIER "${first_name}" id)
    find_path(GRPC_${id}_INCLUDE_DIR ${arg_HEADER})
    find_library(GRPC_${id}_LIBRARY NAMES ${arg_NAMES})
    if(GRPC_${id}_INCLUDE_DIR AND GRPC_${id}_LIBRARY)
      if(NOT TARGET grpc_dep_${id})
        add_library(grpc_dep_${id} UNKNOWN IMPORTED)
        set_target_properties(grpc_dep_${id} PROPERTIES
          IMPORTED_LOCATION "${GRPC_${id}_LIBRARY}"
          INTERFACE_INCLUDE_DIRECTORIES "${GRPC_${id}_INCLUDE_DIR}")
      endif()
      set(${out} grpc_dep_${id} PARENT_SCOPE)
    endif()
  endif()
endfunction()

# Optional library features: <feature> stays AUTO/ON/OFF; GRPC_<feature>_FOUND/_TARGET are set.
macro(grpc_find_optional_library feature)
  set(GRPC_${feature}_TARGET "")
  if(NOT GRPC_${feature} STREQUAL "OFF")
    grpc_find_library_target(GRPC_${feature}_TARGET ${ARGN})
  endif()
  if(GRPC_${feature}_TARGET)
    set(GRPC_${feature}_FOUND TRUE)
  else()
    set(GRPC_${feature}_FOUND FALSE)
  endif()
endmacro()

