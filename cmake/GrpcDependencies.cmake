  find_path(FLATCC_INCLUDE_DIR flatcc/flatcc_builder.h HINTS "${GRPC_FLATCC_PREFIX}/include")
  find_library(FLATCC_LIBRARY NAMES flatccrt HINTS "${GRPC_FLATCC_PREFIX}/lib")
  if(FLATCC_EXECUTABLE AND FLATCC_INCLUDE_DIR AND FLATCC_LIBRARY)
    set(GRPC_FLATCC_FOUND TRUE)
  endif()
