# Python for the tests: the integration tests and the Python example clients need grpcio,
# grpcio-tools and protobuf (plus flatbuffers with FlatBuffers). The HTTP/3 example runner needs
# only the standard library.
#
# Interpreters tried, first match wins: Python3_EXECUTABLE (FindPython's choice, or the one given on
# the command line), then python3 and python on PATH. If none has the modules and Python is bundled
# (GRPC_DEPENDENCIES=BUNDLED and "python" not in GRPC_SYSTEM_DEPENDENCIES), CMake creates a virtual
# environment in the build directory and installs scripts/requirements-test.txt into it. Otherwise
# the Python integration tests are skipped, with instructions, instead of failing the build.
#
# Sets GRPC_PYTHON_EXECUTABLE (any interpreter, possibly empty) and GRPC_PYTHON_GRPC_READY (TRUE when
# that interpreter has the modules), and clears GRPC_BUILD_INTEGRATION_TESTS when it does not.

set(GRPC_PYTHON_EXECUTABLE "")
set(GRPC_PYTHON_GRPC_READY FALSE)
set(GRPC_PYTHON_REQUIREMENTS "${CMAKE_CURRENT_SOURCE_DIR}/scripts/requirements-test.txt")

function(_grpc_python_has out python)
  list(JOIN ARGN ", " modules)
  execute_process(COMMAND "${python}" -c "import ${modules}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(result EQUAL 0)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# Creates (or reuses) the build's virtual environment with the test requirements. Sets <out> to its
# interpreter, or to "" with <out>_ERROR.
function(_grpc_python_venv out base)
  set(${out} "" PARENT_SCOPE)
  set(venv "${FETCHCONTENT_BASE_DIR}/python-venv")
  if(WIN32)
    set(python "${venv}/Scripts/python.exe")
  else()
    set(python "${venv}/bin/python")
  endif()
  set(log "${FETCHCONTENT_BASE_DIR}/bundled/logs/python-venv.log")
  file(MAKE_DIRECTORY "${FETCHCONTENT_BASE_DIR}/bundled/logs")
  file(SHA256 "${GRPC_PYTHON_REQUIREMENTS}" requirements_hash)
  set(stamp_content "${base}|${requirements_hash}")
  if(EXISTS "${venv}/.grpc-stamp" AND EXISTS "${python}")
    file(READ "${venv}/.grpc-stamp" previous)
    if(previous STREQUAL stamp_content)
      _grpc_python_has(ready "${python}" ${ARGN})
      if(ready)
        set(${out} "${python}" PARENT_SCOPE)
        return()
      endif()
    endif()
  endif()

  message(STATUS "ezGRPC-next: installing the Python test requirements into ${venv}")
  find_program(GRPC_UV_EXECUTABLE uv)
  file(REMOVE_RECURSE "${venv}")
  execute_process(COMMAND "${base}" -m venv "${venv}"
    RESULT_VARIABLE result OUTPUT_FILE "${log}" ERROR_FILE "${log}")
  set(use_uv FALSE)
  if(NOT result EQUAL 0)
    if(NOT GRPC_UV_EXECUTABLE)
      set(${out}_ERROR "`${base} -m venv` failed (on Debian/Ubuntu: apt install python3-venv); see ${log}" PARENT_SCOPE)
      return()
    endif()
    file(REMOVE_RECURSE "${venv}")
    execute_process(COMMAND "${GRPC_UV_EXECUTABLE}" venv --python "${base}" "${venv}"
      RESULT_VARIABLE result OUTPUT_FILE "${log}" ERROR_FILE "${log}")
    if(NOT result EQUAL 0)
      set(${out}_ERROR "neither `${base} -m venv` nor `uv venv` worked; see ${log}" PARENT_SCOPE)
      return()
    endif()
    set(use_uv TRUE)
  endif()
  if(use_uv)
    set(install "${GRPC_UV_EXECUTABLE}" pip install --python "${python}")
  else()
    set(install "${python}" -m pip install --disable-pip-version-check --quiet)
  endif()
  execute_process(COMMAND ${install} -r "${GRPC_PYTHON_REQUIREMENTS}"
    RESULT_VARIABLE result OUTPUT_FILE "${log}" ERROR_FILE "${log}")
  if(NOT result EQUAL 0)
    set(${out}_ERROR "installing ${GRPC_PYTHON_REQUIREMENTS} failed (network or index access?); see ${log}" PARENT_SCOPE)
    return()
  endif()
  _grpc_python_has(ready "${python}" ${ARGN})
  if(NOT ready)
    set(${out}_ERROR "the virtual environment still lacks a module after installing the requirements; see ${log}" PARENT_SCOPE)
    return()
  endif()
  file(WRITE "${venv}/.grpc-stamp" "${stamp_content}")
  set(${out} "${python}" PARENT_SCOPE)
endfunction()

if(GRPC_BUILD_EXAMPLES AND (GRPC_BUILD_INTEGRATION_TESTS OR GRPC_BUILD_TESTS))
  find_package(Python3 COMPONENTS Interpreter QUIET)
  find_program(GRPC_PYTHON_ON_PATH NAMES python3 python)
  set(_grpc_py_candidates)
  foreach(_py IN ITEMS "${Python3_EXECUTABLE}" "${GRPC_PYTHON_ON_PATH}")
    if(_py AND EXISTS "${_py}")
      file(REAL_PATH "${_py}" _py_real)
      if(NOT _py_real IN_LIST _grpc_py_candidates_real)
        list(APPEND _grpc_py_candidates "${_py}")
        list(APPEND _grpc_py_candidates_real "${_py_real}")
      endif()
    endif()
  endforeach()
  if(_grpc_py_candidates)
    list(GET _grpc_py_candidates 0 GRPC_PYTHON_EXECUTABLE)
  endif()

  if(GRPC_BUILD_INTEGRATION_TESTS)
    set(_grpc_py_modules grpc)
    if(GRPC_PROTOBUF_C_ENABLED AND PROTOC_C_EXECUTABLE)
      list(APPEND _grpc_py_modules grpc_tools.protoc google.protobuf)
    endif()
    if(GRPC_FLATCC_ENABLED)
      list(APPEND _grpc_py_modules flatbuffers)
    endif()
    foreach(_py IN LISTS _grpc_py_candidates)
      _grpc_python_has(_ready "${_py}" ${_grpc_py_modules})
      if(_ready)
        set(GRPC_PYTHON_EXECUTABLE "${_py}")
        set(GRPC_PYTHON_GRPC_READY TRUE)
        grpc_report_dependency(python "system (${_py})")
        break()
      endif()
    endforeach()

    set(_grpc_py_problem "")
    if(NOT GRPC_PYTHON_GRPC_READY)
      list(JOIN _grpc_py_modules ", " _grpc_py_module_text)
      if(NOT _grpc_py_candidates)
        set(_grpc_py_problem "no Python 3 interpreter was found")
      else()
        list(JOIN _grpc_py_candidates ", " _grpc_py_tried)
        set(_grpc_py_problem "no Python interpreter has ${_grpc_py_module_text} (tried ${_grpc_py_tried})")
        grpc_dependency_is_bundled(_grpc_py_bundled python)
        if(_grpc_py_bundled)
          _grpc_python_venv(_venv_python "${GRPC_PYTHON_EXECUTABLE}" ${_grpc_py_modules})
          if(_venv_python)
            set(GRPC_PYTHON_EXECUTABLE "${_venv_python}")
            set(GRPC_PYTHON_GRPC_READY TRUE)
            grpc_report_dependency(python "bundled virtual environment (${_venv_python})")
          else()
            string(APPEND _grpc_py_problem ", and the bundled virtual environment failed: ${_venv_python_ERROR}")
          endif()
        endif()
      endif()
    endif()
    if(NOT GRPC_PYTHON_GRPC_READY)
      set(_grpc_py_fix "-DPython3_EXECUTABLE=<python with them>")
      if(GRPC_PYTHON_EXECUTABLE)
        set(_grpc_py_fix "${GRPC_PYTHON_EXECUTABLE} -m pip install -r ${GRPC_PYTHON_REQUIREMENTS}, or ${_grpc_py_fix}")
      endif()
      message(WARNING "ezGRPC-next: the Python integration tests are skipped: ${_grpc_py_problem}.\n"
        "To run them: ${_grpc_py_fix}, then reconfigure; or pass -DGRPC_BUILD_INTEGRATION_TESTS=OFF to silence this.")
      set(GRPC_BUILD_INTEGRATION_TESTS OFF)
      grpc_report_dependency(python "missing modules, Python integration tests skipped")
    endif()
  endif()
endif()
